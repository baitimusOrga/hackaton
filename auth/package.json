{
  "name": "hackaton-auth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts"
  },
  "dependencies": { "better-auth": "1.7.12", "pg": "8.23.1" },
  "devDependencies": { "@types/node": "^24", "@types/pg": "^8", "jose": "^6", "tsx": "^4", "typescript": "~6.0.2" }
}
