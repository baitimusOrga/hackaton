# Run pnpm setup to create .env with a generated local secret.
BETTER_AUTH_SECRET=
# Public origin: Angular proxies /api/auth to the Node service.
BETTER_AUTH_URL=http://localhost:4200
DATABASE_URL=postgres://hackaton:hackaton@localhost:5432/hackaton
PORT=3000
# Optional, for rate limiting behind a proxy (see docs/AUTH.md): comma-separated IPs/CIDRs and a client-IP header.
AUTH_TRUSTED_PROXIES=
AUTH_IP_HEADER=
