#!/usr/bin/env bash
set -uo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
    cat >&2 <<'MSG'

  Push to main refused: changes reach main only through a pull request.

    git switch -c <branch>
    git push -u origin <branch>

MSG
    exit 1
  fi
  # a v* tag triggers the prod release in deploy.yml
  if [[ "$remote_ref" == refs/tags/v* ]] && [ "${ALLOW_TAG_PUSH:-}" != "1" ]; then
    cat >&2 <<'MSG'

  Push of a v* tag refused: it releases to prod. A human who means it:

    ALLOW_TAG_PUSH=1 git push origin <tag>

MSG
    exit 1
  fi
done
exit 0
