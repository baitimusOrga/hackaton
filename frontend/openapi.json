  "components" : {
    "schemas" : {
      "ChooseRouteRequest" : {
        "type" : "object",
        "properties" : {
          "route" : {
            "type" : "string",
            "enum" : [ "SELF_SERVICE", "MANAGED", "DIRECT_PURCHASE" ]
          }
        },
        "required" : [ "route" ]
      },
      "ItemView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "category" : {
            "type" : "string"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "quantityConfirmed" : {
            "type" : "boolean"
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "notes" : {
            "type" : [ "string", "null" ]
          },
          "estimatedUnitChf" : {
            "type" : "number"
          },
          "unitPriceChf" : {
            "type" : "number",
            "description" : "Price per piece used at publishing: the company's price, else the estimate"
          },
          "priceConfirmed" : {
            "type" : "boolean",
            "description" : "Whether the company set the unit price itself"
          },
          "estimatedTotalChf" : {
            "type" : "number"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "LISTED", "SOLD" ]
          },
          "listingId" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          }
        }
      },
      "ProjectDetail" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "companyName" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "locality" : {
            "type" : "string"
          },
          "deadline" : {
            "type" : "string",
            "format" : "date"
          },
          "daysLeft" : {
            "type" : "integer",
            "format" : "int64"
          },
          "route" : {
            "type" : [ "string", "null" ],
            "enum" : [ "SELF_SERVICE", "MANAGED", "DIRECT_PURCHASE" ]
          },
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ItemView"
            }
          },
          "totals" : {
            "$ref" : "#/components/schemas/Totals"
          },
          "routes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/RouteOption"
            }
          },
          "recommendedRoute" : {
            "type" : "string",
            "enum" : [ "SELF_SERVICE", "MANAGED", "DIRECT_PURCHASE" ]
          },
          "recommendationReason" : {
            "type" : "string"
          }
        }
      },
      "RouteOption" : {
        "type" : "object",
        "properties" : {
          "route" : {
            "type" : "string",
            "enum" : [ "SELF_SERVICE", "MANAGED", "DIRECT_PURCHASE" ]
          },
          "netChf" : {
            "type" : "number"
          },
          "serviceFeeChf" : {
            "type" : "number"
          },
          "certain" : {
            "type" : "boolean"
          },
          "timeframe" : {
            "type" : "string"
          },
          "yourWork" : {
            "type" : "string"
          }
        }
      },
      "Totals" : {
        "type" : "object",
        "properties" : {
          "itemLines" : {
            "type" : "integer",
            "format" : "int32"
          },
          "units" : {
            "type" : "integer",
            "format" : "int32"
          },
          "estimatedResaleChf" : {
            "type" : "number"
          },
          "draft" : {
            "type" : "integer",
            "format" : "int32"
          },
          "listed" : {
            "type" : "integer",
            "format" : "int32"
          },
          "sold" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "UpdateItemRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "category" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 10000,
            "minimum" : 1
          },
          "quantityConfirmed" : {
            "type" : "boolean"
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "notes" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          },
          "unitPriceChf" : {
            "type" : [ "number", "null" ],
            "description" : "Price per piece the company sets; null keeps the estimate unconfirmed",
            "exclusiveMinimum" : 0
          }
        },
        "required" : [ "category", "condition", "name" ]
      },
      "SearchRequest" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        },
        "required" : [ "text" ]
      },
      "Requirement" : {
        "type" : "object",
        "properties" : {
          "attribute" : {
            "type" : "string",
            "minLength" : 1
          },
          "value" : {
            "type" : "string",
            "minLength" : 1
          },
          "comparison" : {
            "type" : [ "string", "null" ],
            "enum" : [ "AT_LEAST", "EXACT", "AT_MOST" ]
          }
        },
        "required" : [ "attribute", "value" ]
      },
      "SearchRequirements" : {
        "type" : "object",
        "properties" : {
          "mustHave" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Requirement"
            }
          },
          "niceToHave" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Requirement"
            }
          },
          "category" : {
            "type" : [ "string", "null" ]
          },
          "keywords" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "maxBudgetChf" : {
            "type" : "number"
          },
          "postcode" : {
            "type" : "string"
          },
          "maxDistanceKm" : {
            "type" : "integer",
            "format" : "int32"
          },
          "acceptUnknown" : {
            "type" : "boolean"
          }
        },
        "required" : [ "keywords", "mustHave", "niceToHave" ]
      },
      "ListingSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "priceChf" : {
            "type" : "number"
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "category" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "locality" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          },
          "latitude" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "longitude" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          }
        }
      },
      "SearchMatch" : {
        "type" : "object",
        "properties" : {
          "listing" : {
            "$ref" : "#/components/schemas/ListingSummary"
          },
          "reason" : {
            "type" : "string"
          },
          "missingDetails" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "differences" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "SearchResults" : {
        "type" : "object",
        "properties" : {
          "confirmed" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SearchMatch"
            }
          },
          "possible" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SearchMatch"
            }
          },
          "alternatives" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SearchMatch"
            }
          },
          "compared" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "CreateListingRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 4000,
            "minLength" : 0
          },
          "category" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "priceChf" : {
            "type" : "number",
            "exclusiveMinimum" : 0
