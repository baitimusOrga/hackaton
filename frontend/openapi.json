{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "hackaton API"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/searches" : {
      "post" : {
        "tags" : [ "Search" ],
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SearchRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SearchRequirements"
                }
              }
            }
          }
        }
      }
    },
    "/api/searches/matches" : {
      "post" : {
        "tags" : [ "Search" ],
        "operationId" : "matches",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SearchRequirements"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SearchResults"
                }
              }
            }
          }
        }
      }
    },
    "/api/listings" : {
      "get" : {
        "tags" : [ "Listings" ],
        "operationId" : "list",
        "parameters" : [ {
          "name" : "q",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "category",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "maxPrice",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "number"
          }
        }, {
          "name" : "postcode",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ListingSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Selling" ],
        "operationId" : "publish",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateListingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ListingDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/listing-drafts" : {
      "post" : {
        "tags" : [ "Selling" ],
        "operationId" : "createDraft",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "photos" : {
                    "type" : "array",
                    "items" : {
                      "type" : "string",
                      "format" : "binary"
                    }
                  }
                },
                "required" : [ "photos" ]
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ListingDraft"
                }
              }
            }
          }
        }
      }
    },
    "/api/listing-drafts/web-facts" : {
      "post" : {
        "tags" : [ "Selling" ],
        "operationId" : "completeFacts",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/WebFactsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DraftFact"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/photos/{id}" : {
      "get" : {
        "tags" : [ "Selling" ],
        "operationId" : "getPhoto",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              }
            }
          }
        }
      }
    },
    "/api/listings/{id}" : {
      "get" : {
        "tags" : [ "Listings" ],
        "operationId" : "get",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ListingDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/info" : {
      "get" : {
        "tags" : [ "Info" ],
        "operationId" : "info",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Info"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "SearchRequest" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        },
        "required" : [ "text" ]
      },
      "Requirement" : {
        "type" : "object",
        "properties" : {
          "attribute" : {
            "type" : "string",
            "minLength" : 1
          },
          "value" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "attribute", "value" ]
      },
      "SearchRequirements" : {
        "type" : "object",
        "properties" : {
          "mustHave" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Requirement"
            }
          },
          "niceToHave" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Requirement"
            }
          },
          "category" : {
            "type" : [ "string", "null" ]
          },
          "keywords" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "maxBudgetChf" : {
            "type" : "number"
          },
          "postcode" : {
            "type" : "string"
          },
          "maxDistanceKm" : {
            "type" : "integer",
            "format" : "int32"
          },
          "acceptUnknown" : {
            "type" : "boolean"
          }
        },
        "required" : [ "keywords", "mustHave", "niceToHave" ]
      },
      "ListingSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "priceChf" : {
            "type" : "number"
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "category" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "locality" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          }
        }
      },
      "SearchMatch" : {
        "type" : "object",
        "properties" : {
          "listing" : {
            "$ref" : "#/components/schemas/ListingSummary"
          },
          "reason" : {
            "type" : "string"
          },
          "missingDetails" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "differences" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "SearchResults" : {
        "type" : "object",
        "properties" : {
          "confirmed" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SearchMatch"
            }
          },
          "possible" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SearchMatch"
            }
          },
          "alternatives" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SearchMatch"
            }
          }
        }
      },
      "CreateListingRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 4000,
            "minLength" : 0
          },
          "category" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "priceChf" : {
            "type" : "number",
            "exclusiveMinimum" : 0
          },
          "postcode" : {
            "type" : "string",
            "pattern" : "[0-9]{4}"
          },
          "locality" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "attributes" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "photoIds" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            },
            "maxItems" : 5,
            "minItems" : 0
          }
        },
        "required" : [ "attributes", "category", "condition", "description", "locality", "photoIds", "postcode", "priceChf", "title" ]
      },
      "ListingDetail" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "priceChf" : {
            "type" : "number"
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "category" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "locality" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "attributes" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "sellerName" : {
            "type" : [ "string", "null" ]
          }
        }
      },
      "DraftFact" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "value" : {
            "type" : "string"
          },
          "source" : {
            "type" : "string",
            "enum" : [ "LABEL", "SELLER", "SUGGESTION", "WEB" ]
          },
          "sourceUrl" : {
            "type" : [ "string", "null" ]
          }
        }
      },
      "ListingDraft" : {
        "type" : "object",
        "properties" : {
          "photoIds" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            }
          },
          "category" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "condition" : {
            "type" : [ "string", "null" ],
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "facts" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DraftFact"
            }
          },
          "questions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "price" : {
            "$ref" : "#/components/schemas/PriceEstimate"
          },
          "privacyWarnings" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PrivacyWarning"
            }
          }
        }
      },
      "PriceEstimate" : {
        "type" : "object",
        "properties" : {
          "lowChf" : {
            "type" : [ "number", "null" ]
          },
          "midChf" : {
            "type" : [ "number", "null" ]
          },
          "highChf" : {
            "type" : [ "number", "null" ]
          },
          "confidence" : {
            "type" : "string",
            "enum" : [ "LOW", "MEDIUM", "HIGH" ]
          },
          "provisional" : {
            "type" : "boolean"
          },
          "evidence" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PriceEvidence"
            }
          },
          "explanation" : {
            "type" : "string"
          }
        }
      },
      "PriceEvidence" : {
        "type" : "object",
        "properties" : {
          "listingId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "priceChf" : {
            "type" : "number"
          }
        }
      },
      "PrivacyWarning" : {
        "type" : "object",
        "properties" : {
          "photo" : {
            "type" : "integer",
            "format" : "int32"
          },
          "text" : {
            "type" : "string"
          }
        }
      },
      "KnownFact" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "value" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          },
          "source" : {
            "type" : "string",
            "enum" : [ "LABEL", "SELLER", "SUGGESTION", "WEB" ]
          }
        },
        "required" : [ "name", "source", "value" ]
      },
      "WebFactsRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "category" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "facts" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/KnownFact"
            },
            "maxItems" : 30,
            "minItems" : 0
          }
        },
        "required" : [ "category", "facts", "title" ]
      },
      "Info" : {
        "type" : "object",
        "properties" : {
          "env" : {
            "type" : "string"
          },
          "release" : {
            "type" : "string"
          },
          "revision" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
