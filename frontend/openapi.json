{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "hackaton API"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/listings" : {
      "get" : {
        "tags" : [ "Listings" ],
        "operationId" : "list",
        "parameters" : [ {
          "name" : "q",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "category",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "maxPrice",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "number"
          }
        }, {
          "name" : "postcode",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ListingSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/listings/{id}" : {
      "get" : {
        "tags" : [ "Listings" ],
        "operationId" : "get",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ListingDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/info" : {
      "get" : {
        "tags" : [ "Info" ],
        "operationId" : "info",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Info"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ListingSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "priceChf" : {
            "type" : "number"
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "category" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "locality" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          }
        }
      },
      "ListingDetail" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "priceChf" : {
            "type" : "number"
          },
          "condition" : {
            "type" : "string",
            "enum" : [ "NEW", "LIKE_NEW", "GOOD", "USED", "DEFECTIVE" ]
          },
          "category" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "locality" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "attributes" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "Info" : {
        "type" : "object",
        "properties" : {
          "env" : {
            "type" : "string"
          },
          "release" : {
            "type" : "string"
          },
          "revision" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
