# Settings the backend reads from the environment. Locally everything has a dev default in
# backend/src/main/resources/application.yml, so a local .env is optional.
# On staging/prod they come from GitHub: repo secret STAGING_<NAME> / PROD_<NAME> (see README.md).
# Never commit real values.

# Signing key for login tokens, at least 32 characters
JWT_SECRET=

# Database password (staging/prod: also used by the postgres container)
POSTGRES_PASSWORD=
