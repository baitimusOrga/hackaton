# Settings the backend reads from the environment. Locally everything has a dev default in
# backend/src/main/resources/application.yml, so you only need this for the LLM key:
#   cp .env.example .env   (git-ignored), fill in, then export it before ./mvnw spring-boot:run
#
# On staging/prod these come from GitHub: repo secret/variable STAGING_<NAME> or PROD_<NAME>
# (see README.md "Secrets and settings"). Never commit real values.

# Anthropic API key for /api/ai/* (empty = AI features answer 503)
ANTHROPIC_API_KEY=
# Model for the AI features
LLM_MODEL=claude-opus-5-5

# Signing key for login tokens, at least 32 characters (dev default exists)
JWT_SECRET=

# Database password (staging/prod: also used by the postgres container)
POSTGRES_PASSWORD=

# Demo user + listings on an empty database (true locally and on staging, false on prod)
APP_SEED_DEMO=true
APP_SEED_DEMO_PASSWORD=
